# Copia este archivo como ".env" en esta misma carpeta (backend/) y completa los valores reales.
# NUNCA subas el archivo ".env" real a ningun repositorio.

# --- Servidor ---
PORT=3000

# --- Base de datos MySQL local ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=asistente_tesis
DB_USER=
DB_PASSWORD=

# --- Autenticacion JWT ---
# Usa una cadena larga y aleatoria propia, no la dejes vacia.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- n8n ---
N8N_GENERATE_PROPOSALS_WEBHOOK_URL=http://localhost:5678/webhook/generar-propuestas

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
